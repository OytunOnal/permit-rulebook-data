{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://visa-rules.dev/schema/ruleset.schema.json",
  "title": "Visa Rules dataset",
  "type": "object",
  "required": [
    "schema_version",
    "dataset_version",
    "fields",
    "countries"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "dataset_version": {
      "type": "string",
      "minLength": 1
    },
    "fields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/fieldDef"
      }
    },
    "notices": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/notice"
      }
    },
    "countries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "code",
          "name",
          "routes"
        ],
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[A-Z]{2}$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "routes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/route"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "fieldDef": {
      "type": "object",
      "required": [
        "id",
        "label",
        "short_label",
        "subject",
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "short_label": {
          "type": "string",
          "minLength": 1,
          "description": "How the fact is named in the answer ledger — a plain noun, never the field id."
        },
        "subject": {
          "type": "string",
          "minLength": 1,
          "description": "The fact as a noun phrase inside a sentence (\"whether Germany recognises your qualification\") — what a verdict line says instead of the field id."
        },
        "type": {
          "enum": [
            "enum",
            "money_band"
          ]
        },
        "period": {
          "enum": [
            "month",
            "year"
          ]
        },
        "kind": {
          "enum": [
            "attribute",
            "path",
            "improvable"
          ]
        },
        "options_from": {
          "enum": [
            "countries"
          ]
        },
        "ask_first": {
          "type": "boolean"
        },
        "is_qualifier": {
          "type": "boolean"
        },
        "learn": {
          "type": "object",
          "required": [
            "label",
            "url"
          ],
          "additionalProperties": false,
          "properties": {
            "label": {
              "type": "string",
              "minLength": 1
            },
            "url": {
              "type": "string",
              "pattern": "^https://"
            }
          }
        },
        "options": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": [
              "value",
              "label"
            ],
            "additionalProperties": false,
            "properties": {
              "value": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "short": {
                "type": "string",
                "minLength": 1
              },
              "is_unknown": {
                "type": "boolean"
              },
              "is_fallback": {
                "type": "boolean"
              },
              "implies": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "enum"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "oneOf": [
              {
                "required": [
                  "options"
                ],
                "properties": {
                  "options": true
                }
              },
              {
                "required": [
                  "options_from"
                ],
                "properties": {
                  "options_from": true
                }
              }
            ]
          }
        }
      ]
    },
    "unsourcedReason": {
      "type": "object",
      "description": "Why this statement carries no quote. Exactly one of source/unsourced: a sentence we cannot source is said to be unsourced on the card, never given a neighbouring quote that does not cover it. This was a free-text box with a minimum length, so eleven characters of anything silenced the provenance gate — a check that can be answered by writing something is optional by prose (review 2026-09-07). The absence is an attributable decision instead: a reason from a fixed set, and a date in the same shape a retrieval date takes. Prose may be added in `note`; it may never stand in place of either.",
      "required": [
        "reason",
        "checked_at"
      ],
      "additionalProperties": false,
      "properties": {
        "reason": {
          "enum": [
            "scanned-image",
            "not-published-in-words",
            "unreachable"
          ],
          "description": "scanned-image: the authority publishes the passage only as a scan or image whose text cannot be extracted. not-published-in-words: the authority states the fact, but as a list, table or form rather than in a sentence there is anything to quote. unreachable: no fetch from here reaches the source at all. Grow this list only when a case genuinely occurs — an enumeration nobody can extend by writing prose is the whole point."
        },
        "checked_at": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "The day we last went looking and did not find it — the sourced side's retrieval date, in the sourced side's shape, so it ages the same way."
        },
        "note": {
          "type": "string",
          "minLength": 10,
          "description": "What the reason cannot carry: which document, which page, what was tried. In addition to the reason and the date, never instead of them."
        }
      }
    },
    "provenancedText": {
      "type": "object",
      "required": [
        "source_url",
        "quote",
        "retrieved_at"
      ],
      "additionalProperties": false,
      "properties": {
        "source_url": {
          "type": "string",
          "pattern": "^https://"
        },
        "quote": {
          "type": "string",
          "minLength": 5
        },
        "retrieved_at": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "legal_basis": {
          "type": "string"
        },
        "history": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "retrieved_at"
            ],
            "additionalProperties": false,
            "properties": {
              "retrieved_at": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "quote": {
                "type": "string"
              },
              "source_url": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "notice": {
      "type": "object",
      "required": [
        "id",
        "when",
        "kind",
        "title",
        "body",
        "source"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "when": {
          "type": "object",
          "required": [
            "field",
            "op"
          ],
          "additionalProperties": false,
          "properties": {
            "field": {
              "type": "string",
              "minLength": 1
            },
            "op": {
              "enum": [
                "eq",
                "in"
              ]
            },
            "value": {
              "type": "string",
              "minLength": 1
            },
            "values": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "kind": {
          "enum": [
            "no-permit-needed",
            "extra-rights"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "body": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "$ref": "#/$defs/provenancedText"
        }
      }
    },
    "provenancedAmount": {
      "type": "object",
      "required": [
        "amount",
        "currency",
        "source_url",
        "quote",
        "retrieved_at"
      ],
      "additionalProperties": false,
      "properties": {
        "amount": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "currency": {
          "enum": [
            "EUR"
          ]
        },
        "source_url": {
          "type": "string",
          "pattern": "^https://"
        },
        "quote": {
          "type": "string",
          "minLength": 5
        },
        "retrieved_at": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "legal_basis": {
          "type": "string"
        },
        "history": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "amount",
              "retrieved_at"
            ],
            "additionalProperties": false,
            "properties": {
              "amount": {
                "type": "number"
              },
              "retrieved_at": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "quote": {
                "type": "string"
              },
              "source_url": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "provenancedNumber": {
      "type": "object",
      "required": [
        "value",
        "unit",
        "source_url",
        "quote",
        "retrieved_at"
      ],
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "unit": {
          "enum": [
            "points"
          ]
        },
        "source_url": {
          "type": "string",
          "pattern": "^https://"
        },
        "quote": {
          "type": "string",
          "minLength": 5
        },
        "retrieved_at": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "legal_basis": {
          "type": "string"
        },
        "history": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "value",
              "retrieved_at"
            ],
            "additionalProperties": false,
            "properties": {
              "value": {
                "type": "number"
              },
              "retrieved_at": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "quote": {
                "type": "string"
              },
              "source_url": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "pointsTable": {
      "type": "object",
      "required": [
        "source_url",
        "quote",
        "retrieved_at",
        "items"
      ],
      "additionalProperties": false,
      "properties": {
        "source_url": {
          "type": "string",
          "pattern": "^https://"
        },
        "quote": {
          "type": "string",
          "minLength": 5
        },
        "retrieved_at": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "legal_basis": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "field",
              "points"
            ],
            "additionalProperties": false,
            "properties": {
              "field": {
                "type": "string"
              },
              "points": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": {
                  "type": "number",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    },
    "criterion": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "field",
            "op",
            "value"
          ],
          "additionalProperties": false,
          "properties": {
            "field": {
              "type": "string"
            },
            "op": {
              "const": "eq"
            },
            "value": {
              "type": "string"
            },
            "note": {
              "type": "string"
            },
            "short_reason": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "required": [
            "field",
            "op",
            "threshold"
          ],
          "additionalProperties": false,
          "properties": {
            "field": {
              "type": "string"
            },
            "op": {
              "const": "gte"
            },
            "threshold": {
              "$ref": "#/$defs/provenancedAmount"
            },
            "threshold_label": {
              "type": "string"
            },
            "note": {
              "type": "string"
            },
            "short_reason": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "required": [
            "field",
            "op",
            "values"
          ],
          "additionalProperties": false,
          "properties": {
            "field": {
              "type": "string"
            },
            "op": {
              "const": "in"
            },
            "values": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "note": {
              "type": "string"
            },
            "short_reason": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "required": [
            "op",
            "required",
            "table"
          ],
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "points"
            },
            "required": {
              "$ref": "#/$defs/provenancedNumber"
            },
            "table": {
              "$ref": "#/$defs/pointsTable"
            },
            "note": {
              "type": "string"
            },
            "short_reason": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "required": [
            "op",
            "paths"
          ],
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "any"
            },
            "label": {
              "type": "string"
            },
            "paths": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "object",
                "required": [
                  "criteria"
                ],
                "additionalProperties": false,
                "properties": {
                  "label": {
                    "type": "string"
                  },
                  "criteria": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "$ref": "#/$defs/criterion"
                    }
                  }
                }
              }
            },
            "note": {
              "type": "string"
            },
            "short_reason": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "routeStatement": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "text"
      ],
      "oneOf": [
        {
          "required": [
            "source"
          ],
          "properties": {
            "source": true
          },
          "not": {
            "required": [
              "unsourced"
            ],
            "properties": {
              "unsourced": true
            }
          }
        },
        {
          "required": [
            "unsourced"
          ],
          "properties": {
            "unsourced": true
          },
          "not": {
            "required": [
              "source"
            ],
            "properties": {
              "source": true
            }
          }
        }
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "kind": {
          "enum": [
            "precondition",
            "caveat"
          ],
          "description": "precondition: something the applicant must satisfy that the interview never asks. It joins `route.preconditions` in the same list under the same heading, so it IS a precondition — one that carries its quote — and calling it a `condition` coined a synonym for a term the glossary already fixes (review 2026-09-07). caveat: a qualification the source puts on its own answer, which sits beside the verdict and never fails anyone."
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "description": "Our plain English, what the reader sees. The quote beside it is the source's own words."
        },
        "source": {
          "$ref": "#/$defs/provenancedText"
        },
        "unsourced": {
          "$ref": "#/$defs/unsourcedReason"
        }
      }
    },
    "route": {
      "type": "object",
      "required": [
        "id",
        "name",
        "kind",
        "criteria",
        "info_url"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z]{2}(-[a-z0-9]+)+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "res-work",
            "seek",
            "self-employed"
          ]
        },
        "summary": {
          "type": "string"
        },
        "info_url": {
          "type": "string",
          "pattern": "^https://"
        },
        "criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/criterion"
          }
        },
        "preconditions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "statements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/routeStatement"
          }
        }
      }
    }
  }
}
