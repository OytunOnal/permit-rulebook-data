{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://permitrulebook.com/schema/ruleset.schema.json",
  "title": "Permit Rulebook dataset",
  "type": "object",
  "required": [
    "schema_version",
    "dataset_version",
    "fields",
    "countries"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "dataset_version": {
      "type": "string",
      "minLength": 1
    },
    "fields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/fieldDef"
      }
    },
    "notices": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/notice"
      }
    },
    "contradictions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/contradiction"
      }
    },
    "countries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "code",
          "name",
          "routes"
        ],
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[A-Z]{2}$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "routes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/route"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "fieldDef": {
      "type": "object",
      "required": [
        "id",
        "label",
        "short_label",
        "subject",
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "short_label": {
          "type": "string",
          "minLength": 1,
          "description": "How the fact is named in the answer ledger — a plain noun, never the field id."
        },
        "unknown_label": {
          "type": "string",
          "minLength": 1,
          "description": "On a money question, what the answer that is not an amount is called — the door for a reader the question does not fit. Optional; the question layer has a plain default."
        },
        "subject": {
          "type": "string",
          "minLength": 1,
          "description": "The fact as a noun phrase inside a sentence (\"whether Germany recognises your qualification\") — what a verdict line says instead of the field id."
        },
        "type": {
          "enum": [
            "enum",
            "money_band"
          ]
        },
        "period": {
          "enum": [
            "month",
            "year"
          ]
        },
        "kind": {
          "enum": [
            "attribute",
            "path",
            "improvable"
          ]
        },
        "options_from": {
          "enum": [
            "countries"
          ]
        },
        "ask_first": {
          "type": "boolean"
        },
        "is_qualifier": {
          "type": "boolean"
        },
        "learn": {
          "type": "object",
          "required": [
            "label",
            "url"
          ],
          "additionalProperties": false,
          "properties": {
            "label": {
              "type": "string",
              "minLength": 1
            },
            "url": {
              "type": "string",
              "pattern": "^https://"
            }
          }
        },
        "options": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": [
              "value",
              "label"
            ],
            "additionalProperties": false,
            "properties": {
              "value": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "short": {
                "type": "string",
                "minLength": 1
              },
              "means": {
                "type": "string",
                "minLength": 1,
                "description": "What choosing this answer means in this interview, in our words, where the label alone leaves two answers hard to tell apart. May carry the token {place}, filled in from the reader's declared destination."
              },
              "is_unknown": {
                "type": "boolean"
              },
              "is_fallback": {
                "type": "boolean"
              },
              "implies": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "enum"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "oneOf": [
              {
                "required": [
                  "options"
                ],
                "properties": {
                  "options": true
                }
              },
              {
                "required": [
                  "options_from"
                ],
                "properties": {
                  "options_from": true
                }
              }
            ]
          }
        }
      ]
    },
    "unsourcedReason": {
      "type": "object",
      "description": "Why this statement carries no quote. Exactly one of source/unsourced: a sentence we cannot source is said to be unsourced on the card, never given a neighbouring quote that does not cover it. This was a free-text box with a minimum length, so eleven characters of anything silenced the provenance gate — a check that can be answered by writing something is optional by prose (review 2026-09-07). The absence is an attributable decision instead: a reason from a fixed set, and a date in the same shape a retrieval date takes. Prose may be added in `note`; it may never stand in place of either.",
      "required": [
        "reason",
        "checked_at"
      ],
      "additionalProperties": false,
      "properties": {
        "reason": {
          "enum": [
            "scanned-image",
            "not-published-in-words",
            "unreachable"
          ],
          "description": "scanned-image: the authority publishes the passage only as a scan or image whose text cannot be extracted. not-published-in-words: the authority states the fact, but as a list, table or form rather than in a sentence there is anything to quote. unreachable: no fetch from here reaches the source at all. Grow this list only when a case genuinely occurs — an enumeration nobody can extend by writing prose is the whole point."
        },
        "checked_at": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "The day we last went looking and did not find it — the sourced side's retrieval date, in the sourced side's shape, so it ages the same way."
        },
        "note": {
          "type": "string",
          "minLength": 10,
          "description": "What the reason cannot carry: which document, which page, what was tried. In addition to the reason and the date, never instead of them."
        }
      }
    },
    "provenancedText": {
      "type": "object",
      "required": [
        "source_url",
        "quote",
        "retrieved_at"
      ],
      "additionalProperties": false,
      "properties": {
        "source_url": {
          "type": "string",
          "pattern": "^https://"
        },
        "quote": {
          "type": "string",
          "minLength": 5
        },
        "retrieved_at": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "legal_basis": {
          "type": "string"
        },
        "history": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "retrieved_at"
            ],
            "additionalProperties": false,
            "properties": {
              "retrieved_at": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "quote": {
                "type": "string"
              },
              "source_url": {
                "type": "string"
              },
              "note": {
                "type": "string",
                "minLength": 1,
                "description": "The reason in the curator's own words, where the enum does not carry enough: what moved, or which sentence replaced which. Optional prose; `reason` is what anything mechanical reads."
              },
              "reason": {
                "type": "string",
                "enum": [
                  "re-read-unchanged",
                  "value-changed",
                  "source-moved",
                  "quote-corrected"
                ],
                "description": "Why this reading was superseded, from the closed list: re-read-unchanged (read again at its source on a new day, same value), value-changed (the authority published a different value), source-moved (the same value, read at a new URL), quote-corrected (the value stood, the sentence quoted for it did not). Required on every entry written from 2026-09-08. Entries older than that carry none: they were written before the list existed, and rewriting history to fit a new field would be the one edit this format forbids."
              },
              "checked_at": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                "description": "The day this entry was written — the day a person looked and recorded what they found. `retrieved_at` is the day the superseded value itself was read, which is a different day and, for a re-read, the whole point of the entry."
              }
            }
          }
        }
      }
    },
    "contradiction": {
      "type": "object",
      "required": [
        "id",
        "when",
        "say"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "when": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": [
              "field",
              "in"
            ],
            "additionalProperties": false,
            "properties": {
              "field": {
                "type": "string"
              },
              "in": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "say": {
          "type": "string",
          "minLength": 20
        }
      }
    },
    "notice": {
      "type": "object",
      "required": [
        "id",
        "when",
        "kind",
        "title",
        "body",
        "source"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "when": {
          "type": "object",
          "required": [
            "field",
            "op"
          ],
          "additionalProperties": false,
          "properties": {
            "field": {
              "type": "string",
              "minLength": 1
            },
            "op": {
              "enum": [
                "eq",
                "in"
              ]
            },
            "value": {
              "type": "string",
              "minLength": 1
            },
            "values": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "kind": {
          "enum": [
            "no-permit-needed",
            "extra-rights"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "body": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "$ref": "#/$defs/provenancedText"
        }
      }
    },
    "provenancedAmount": {
      "type": "object",
      "required": [
        "amount",
        "currency",
        "source_url",
        "quote",
        "retrieved_at"
      ],
      "additionalProperties": false,
      "properties": {
        "amount": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "currency": {
          "enum": [
            "EUR"
          ]
        },
        "source_url": {
          "type": "string",
          "pattern": "^https://"
        },
        "quote": {
          "type": "string",
          "minLength": 5
        },
        "retrieved_at": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "legal_basis": {
          "type": "string"
        },
        "history": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "amount",
              "retrieved_at"
            ],
            "additionalProperties": false,
            "properties": {
              "amount": {
                "type": "number"
              },
              "retrieved_at": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "quote": {
                "type": "string"
              },
              "source_url": {
                "type": "string"
              },
              "note": {
                "type": "string",
                "minLength": 1,
                "description": "The reason in the curator's own words, where the enum does not carry enough: what moved, or which sentence replaced which. Optional prose; `reason` is what anything mechanical reads."
              },
              "reason": {
                "type": "string",
                "enum": [
                  "re-read-unchanged",
                  "value-changed",
                  "source-moved",
                  "quote-corrected"
                ],
                "description": "Why this reading was superseded, from the closed list: re-read-unchanged (read again at its source on a new day, same value), value-changed (the authority published a different value), source-moved (the same value, read at a new URL), quote-corrected (the value stood, the sentence quoted for it did not). Required on every entry written from 2026-09-08. Entries older than that carry none: they were written before the list existed, and rewriting history to fit a new field would be the one edit this format forbids."
              },
              "checked_at": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                "description": "The day this entry was written — the day a person looked and recorded what they found. `retrieved_at` is the day the superseded value itself was read, which is a different day and, for a re-read, the whole point of the entry."
              }
            }
          }
        }
      }
    },
    "provenancedNumber": {
      "type": "object",
      "required": [
        "value",
        "unit",
        "source_url",
        "quote",
        "retrieved_at"
      ],
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "unit": {
          "enum": [
            "points"
          ]
        },
        "source_url": {
          "type": "string",
          "pattern": "^https://"
        },
        "quote": {
          "type": "string",
          "minLength": 5
        },
        "retrieved_at": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "legal_basis": {
          "type": "string"
        },
        "history": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "value",
              "retrieved_at"
            ],
            "additionalProperties": false,
            "properties": {
              "value": {
                "type": "number"
              },
              "retrieved_at": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "quote": {
                "type": "string"
              },
              "source_url": {
                "type": "string"
              },
              "note": {
                "type": "string",
                "minLength": 1,
                "description": "The reason in the curator's own words, where the enum does not carry enough: what moved, or which sentence replaced which. Optional prose; `reason` is what anything mechanical reads."
              },
              "reason": {
                "type": "string",
                "enum": [
                  "re-read-unchanged",
                  "value-changed",
                  "source-moved",
                  "quote-corrected"
                ],
                "description": "Why this reading was superseded, from the closed list: re-read-unchanged (read again at its source on a new day, same value), value-changed (the authority published a different value), source-moved (the same value, read at a new URL), quote-corrected (the value stood, the sentence quoted for it did not). Required on every entry written from 2026-09-08. Entries older than that carry none: they were written before the list existed, and rewriting history to fit a new field would be the one edit this format forbids."
              },
              "checked_at": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                "description": "The day this entry was written — the day a person looked and recorded what they found. `retrieved_at` is the day the superseded value itself was read, which is a different day and, for a re-read, the whole point of the entry."
              }
            }
          }
        }
      }
    },
    "pointsTable": {
      "type": "object",
      "required": [
        "source_url",
        "quote",
        "retrieved_at",
        "items"
      ],
      "additionalProperties": false,
      "properties": {
        "source_url": {
          "type": "string",
          "pattern": "^https://"
        },
        "quote": {
          "type": "string",
          "minLength": 5
        },
        "retrieved_at": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "legal_basis": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "field",
              "points"
            ],
            "additionalProperties": false,
            "properties": {
              "field": {
                "type": "string"
              },
              "points": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": {
                  "type": "number",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    },
    "criterion": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "field",
            "op",
            "value"
          ],
          "additionalProperties": false,
          "properties": {
            "field": {
              "type": "string"
            },
            "op": {
              "const": "eq"
            },
            "value": {
              "type": "string"
            },
            "short_reason": {
              "$ref": "#/$defs/criterionShortReason"
            },
            "source": {
              "$ref": "#/$defs/criterionSource"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "field",
            "op",
            "threshold"
          ],
          "additionalProperties": false,
          "properties": {
            "field": {
              "type": "string"
            },
            "op": {
              "const": "gte"
            },
            "threshold": {
              "$ref": "#/$defs/provenancedAmount"
            },
            "threshold_label": {
              "type": "string"
            },
            "short_reason": {
              "$ref": "#/$defs/criterionShortReason"
            },
            "source": {
              "$ref": "#/$defs/criterionSource"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "field",
            "op",
            "values"
          ],
          "additionalProperties": false,
          "properties": {
            "field": {
              "type": "string"
            },
            "op": {
              "const": "in"
            },
            "values": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "short_reason": {
              "$ref": "#/$defs/criterionShortReason"
            },
            "source": {
              "$ref": "#/$defs/criterionSource"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "op",
            "required",
            "table"
          ],
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "points"
            },
            "required": {
              "$ref": "#/$defs/provenancedNumber"
            },
            "table": {
              "$ref": "#/$defs/pointsTable"
            },
            "short_reason": {
              "$ref": "#/$defs/criterionShortReason"
            },
            "source": {
              "$ref": "#/$defs/criterionSource"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "op",
            "paths"
          ],
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "any"
            },
            "label": {
              "type": "string"
            },
            "paths": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "object",
                "required": [
                  "criteria"
                ],
                "additionalProperties": false,
                "properties": {
                  "label": {
                    "type": "string"
                  },
                  "criteria": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "$ref": "#/$defs/criterion"
                    }
                  }
                }
              }
            },
            "short_reason": {
              "$ref": "#/$defs/criterionShortReason"
            },
            "source": {
              "$ref": "#/$defs/criterionSource"
            }
          }
        }
      ]
    },
    "routeStatement": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "text"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "kind": {
          "enum": [
            "precondition",
            "caveat"
          ],
          "description": "precondition: something the applicant must satisfy that the interview never asks. It joins `route.preconditions` in the same list under the same heading, so it IS a precondition — one that carries its quote — and calling it a `condition` coined a synonym for a term the glossary already fixes (review 2026-09-07). caveat: a qualification the source puts on its own answer, which sits beside the verdict and never fails anyone. Both are things a SOURCE says about the route; our own reading of it is a `route.readings` entry, which is a different construct because it is a different thing (review 2026-09-07)."
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "description": "Our plain English, what the reader sees. The quote beside it is the source's own words."
        },
        "source": {
          "$ref": "#/$defs/provenancedText"
        },
        "unsourced": {
          "$ref": "#/$defs/unsourcedReason"
        }
      },
      "allOf": [
        {
          "$ref": "#/$defs/sourcedOrDeclaredUnsourced"
        }
      ]
    },
    "route": {
      "type": "object",
      "required": [
        "id",
        "name",
        "kind",
        "criteria",
        "info_url",
        "scope"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z]{2}(-[a-z0-9]+)+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "res-work",
            "seek",
            "self-employed"
          ]
        },
        "summary": {
          "type": "string",
          "description": "One or two sentences about the route. Its FIRST sentence stands alone as the card's gist on a country index and is bounded there (see the build's summaryFirstSentence check); the whole summary is the route page's own opening line and may run longer.",
          "maxLength": 600
        },
        "info_url": {
          "type": "string",
          "pattern": "^https://"
        },
        "criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/criterion"
          }
        },
        "preconditions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "scope": {
          "$ref": "#/$defs/routeScope"
        },
        "statements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/routeStatement"
          }
        },
        "readings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/routeReading"
          }
        }
      }
    },
    "criterionSource": {
      "$ref": "#/$defs/provenancedText",
      "description": "The authority's own words for the condition this criterion checks — the same provenance a threshold carries, for a condition that is not a number. Until s5e only a threshold could be sourced, so the evidence behind an eq/in/any criterion lived in `note`, a bare string that reached no screen and that nothing watched. `note` is gone: it was the one slot whose text declared no kind, which is how a claim about the law (\"German recognition not required (§ 6 BeschV)\") shipped with no source and passed every gate (review 2026-09-07). Our own words about a route go in `route.readings`; maintainer prose goes in data/exclusions.md."
    },
    "criterionShortReason": {
      "type": "string",
      "minLength": 1,
      "description": "What this criterion asks for, as a noun phrase a person would say (\"an age of 30 or older\"). It overrides the phrasing derived from the named options. A verdict line is built from these, never from a field id (s5d)."
    },
    "sourcedOrDeclaredUnsourced": {
      "type": "object",
      "description": "Exactly one of source/unsourced. A sentence we cannot source says so on the card and is dated; it is never given a neighbouring quote that does not cover it.",
      "oneOf": [
        {
          "required": [
            "source"
          ],
          "properties": {
            "source": true
          },
          "not": {
            "required": [
              "unsourced"
            ],
            "properties": {
              "unsourced": true
            }
          }
        },
        {
          "required": [
            "unsourced"
          ],
          "properties": {
            "unsourced": true
          },
          "not": {
            "required": [
              "source"
            ],
            "properties": {
              "source": true
            }
          }
        }
      ]
    },
    "routeScope": {
      "type": "object",
      "description": "How much of this route the interview actually asks about, declared in plain words. Absence is not allowed: a route with no coverage value would render as silence, and silence on this question reads as \"we asked everything\". The value is authored by a curator from data/exclusions.md and the route's own readings; the reason beside it is our own words about our own interview, and it never states what the law requires — the conditions it points at carry their own quotes on the same page.",
      "required": [
        "value",
        "reason",
        "not_asked"
      ],
      "additionalProperties": false,
      "properties": {
        "value": {
          "enum": [
            "every-deciding-rule-asked",
            "some-conditions-stated-not-asked",
            "rules-quoted-nothing-asked"
          ],
          "description": "every-deciding-rule-asked: every rule this route turns on is a question the interview asks. some-conditions-stated-not-asked: the page states conditions — the authority's, or our own reading — that decide the case and the interview does not ask about; it names which. rules-quoted-nothing-asked: the route's rules are quoted and shown, and nothing on it is asked."
        },
        "reason": {
          "type": "string",
          "minLength": 40,
          "description": "The curator's one line beside the value: what is asked here and what is not, in the words the page prints. The floor is a sentence's worth of characters — it is there so an empty string or a single word cannot satisfy a required field, not as a style rule."
        },
        "not_asked": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "uniqueItems": true,
          "description": "The statement and reading ids this route names to the reader and never asks about. Held against data/exclusions.md's machine-readable twin in both directions: every limb the file records must be named here, and every id named here must exist on the route."
        }
      }
    },
    "routeReading": {
      "type": "object",
      "description": "OUR reading of a route — what we modelled, what we did not, where a number came from a page no machine re-reads. It shipped as a third RouteStatement kind (`modelling`) until this review; the glossary defines a route statement as something a SOURCE says, so a reading inside that construct was an undeclared second exception to Provenance, told apart from the authority's words only by a kind enum checked at nine sites across two repos. It carries no source and no unsourced reason: there is no authority to cite and no absence to explain. Being in this array IS the attribution, and the card renders it as \"Our reading, not the authority's words\".",
      "required": [
        "id",
        "text"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "description": "Our own words, shown to the reader as ours."
        }
      }
    }
  }
}
