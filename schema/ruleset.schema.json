{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://visa-rules.dev/schema/ruleset.schema.json",
  "title": "Visa Rules dataset",
  "type": "object",
  "required": ["schema_version", "dataset_version", "fields", "countries"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "dataset_version": { "type": "string", "minLength": 1 },
    "fields": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/fieldDef" }
    },
    "countries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["code", "name", "routes"],
        "additionalProperties": false,
        "properties": {
          "code": { "type": "string", "pattern": "^[A-Z]{2}$" },
          "name": { "type": "string", "minLength": 1 },
          "routes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/route" } }
        }
      }
    }
  },
  "$defs": {
    "fieldDef": {
      "type": "object",
      "required": ["id", "label", "type"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "label": { "type": "string", "minLength": 1 },
        "type": { "enum": ["enum", "money_band"] },
        "kind": { "enum": ["attribute", "path", "improvable"] },
        "learn": {
          "type": "object",
          "required": ["label", "url"],
          "additionalProperties": false,
          "properties": {
            "label": { "type": "string", "minLength": 1 },
            "url": { "type": "string", "pattern": "^https://" }
          }
        },
        "options": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": ["value", "label"],
            "additionalProperties": false,
            "properties": {
              "value": { "type": "string", "minLength": 1 },
              "label": { "type": "string", "minLength": 1 },
              "short": { "type": "string", "minLength": 1 },
              "is_unknown": { "type": "boolean" },
              "is_fallback": { "type": "boolean" }
            }
          }
        }
      }
    },
    "provenancedAmount": {
      "type": "object",
      "required": ["amount", "currency", "source_url", "quote", "retrieved_at"],
      "additionalProperties": false,
      "properties": {
        "amount": { "type": "number", "exclusiveMinimum": 0 },
        "currency": { "enum": ["EUR"] },
        "source_url": { "type": "string", "pattern": "^https://" },
        "quote": { "type": "string", "minLength": 5 },
        "retrieved_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "legal_basis": { "type": "string" },
        "history": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["amount", "retrieved_at"],
            "additionalProperties": false,
            "properties": {
              "amount": { "type": "number" },
              "retrieved_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
              "quote": { "type": "string" },
              "source_url": { "type": "string" }
            }
          }
        }
      }
    },
    "provenancedNumber": {
      "type": "object",
      "required": ["value", "unit", "source_url", "quote", "retrieved_at"],
      "additionalProperties": false,
      "properties": {
        "value": { "type": "number", "exclusiveMinimum": 0 },
        "unit": { "enum": ["points"] },
        "source_url": { "type": "string", "pattern": "^https://" },
        "quote": { "type": "string", "minLength": 5 },
        "retrieved_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "legal_basis": { "type": "string" },
        "history": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["value", "retrieved_at"],
            "additionalProperties": false,
            "properties": {
              "value": { "type": "number" },
              "retrieved_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
              "quote": { "type": "string" },
              "source_url": { "type": "string" }
            }
          }
        }
      }
    },
    "pointsTable": {
      "type": "object",
      "required": ["source_url", "quote", "retrieved_at", "items"],
      "additionalProperties": false,
      "properties": {
        "source_url": { "type": "string", "pattern": "^https://" },
        "quote": { "type": "string", "minLength": 5 },
        "retrieved_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "legal_basis": { "type": "string" },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["field", "points"],
            "additionalProperties": false,
            "properties": {
              "field": { "type": "string" },
              "points": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": { "type": "number", "minimum": 0 }
              }
            }
          }
        }
      }
    },
    "criterion": {
      "oneOf": [
        {
          "type": "object",
          "required": ["field", "op", "value"],
          "additionalProperties": false,
          "properties": {
            "field": { "type": "string" },
            "op": { "const": "eq" },
            "value": { "type": "string" },
            "note": { "type": "string" }
          }
        },
        {
          "type": "object",
          "required": ["field", "op", "threshold"],
          "additionalProperties": false,
          "properties": {
            "field": { "type": "string" },
            "op": { "const": "gte" },
            "threshold": { "$ref": "#/$defs/provenancedAmount" },
            "threshold_label": { "type": "string" },
            "note": { "type": "string" }
          }
        },
        {
          "type": "object",
          "required": ["field", "op", "values"],
          "additionalProperties": false,
          "properties": {
            "field": { "type": "string" },
            "op": { "const": "in" },
            "values": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "note": { "type": "string" }
          }
        },
        {
          "type": "object",
          "required": ["op", "required", "table"],
          "additionalProperties": false,
          "properties": {
            "op": { "const": "points" },
            "required": { "$ref": "#/$defs/provenancedNumber" },
            "table": { "$ref": "#/$defs/pointsTable" },
            "note": { "type": "string" }
          }
        },
        {
          "type": "object",
          "required": ["op", "paths"],
          "additionalProperties": false,
          "properties": {
            "op": { "const": "any" },
            "label": { "type": "string" },
            "paths": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "object",
                "required": ["criteria"],
                "additionalProperties": false,
                "properties": {
                  "label": { "type": "string" },
                  "criteria": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/criterion" } }
                }
              }
            },
            "note": { "type": "string" }
          }
        }
      ]
    },
    "route": {
      "type": "object",
      "required": ["id", "name", "kind", "criteria", "info_url"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z]{2}(-[a-z0-9]+)+$" },
        "name": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["res-work", "seek", "self-employed"] },
        "summary": { "type": "string" },
        "info_url": { "type": "string", "pattern": "^https://" },
        "criteria": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/criterion" } }
      }
    }
  }
}
